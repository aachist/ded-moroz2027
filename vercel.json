{
  "rewrites": [
    {
      "source": "/api/availability/:code",
      "destination": "/api/bookings?view=availability&code=:code"
    },
    {
      "source": "/api/bookings/:code/:id",
      "destination": "/api/bookings?code=:code&id=:id"
    },
    {
      "source": "/api/bookings/:code",
      "destination": "/api/bookings?code=:code"
    },
    {
      "source": "/api/media-list/:code/:id",
      "destination": "/api/media-list?code=:code&id=:id"
    },
    {
      "source": "/api/media-list/:code",
      "destination": "/api/media-list?code=:code"
    },
    {
      "source": "/api/reviews/:code/:id",
      "destination": "/api/reviews?code=:code&id=:id"
    },
    {
      "source": "/api/reviews/:code",
      "destination": "/api/reviews?code=:code"
    },
    {
      "source": "/api/telegram-webhook",
      "destination": "/api/telegram?hook=1"
    },
    {
      "source": "/api/telegram/:code",
      "destination": "/api/telegram?code=:code"
    },
    {
      "source": "/api/hours/:code",
      "destination": "/api/bookings?code=:code&view=hours"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
